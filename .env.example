# Copy to .env.local and fill in. .env.local is git-ignored.

# --- LiveKit Cloud (free dev project at cloud.livekit.io) ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT: Deepgram (console.deepgram.com) ---
DEEPGRAM_API_KEY=

# --- LLM: Groq (console.groq.com) -- fast first-token, free tier ---
GROQ_API_KEY=

# --- TTS: Cartesia (play.cartesia.ai) ---
CARTESIA_API_KEY=

# --- Optional overrides (defaults live in config.py) ---
# JS_STT_MODEL=nova-3
# JS_LLM_MODEL=llama-3.3-70b-versatile
# JS_TTS_VOICE=
# JS_SCHEME=pm_kisan
